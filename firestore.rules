rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function member(crewId) { return signedIn() && exists(/databases/$(database)/documents/crews/$(crewId)/members/$(request.auth.uid)); }
    function admin() { return signedIn() && request.auth.token.email == 'mathew.lovell@gmail.com' && request.auth.token.email_verified == true; }
    function crewOwner(crewId) { return signedIn() && get(/databases/$(database)/documents/crews/$(crewId)).data.owner == request.auth.uid; }

    // Each person's pointer to their crew. Only they can see or change it.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Invite codes. Anyone signed in can look up a code they were given (but not list codes).
    // Only members can create or retire their own crew's codes. Existing codes can't be overwritten.
    match /codes/{code} {
      allow get: if signedIn();
      allow create: if member(request.resource.data.crewId);
      allow delete: if member(resource.data.crewId);
    }

    // Anonymous usage stats. No names or emails; anyone can read them (the stats dashboard does).
    match /daily/{date} {
      allow read: if true;
      allow create, update: if signedIn() && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['workouts', 'home', 'bonus', 'exercises', 'sets', 'stretches', 'onboarded', 'feedback', 'shares', 'ev'])
        && (!('ev' in request.resource.data) || (request.resource.data.ev is map && request.resource.data.ev.size() <= 400));
    }
    match /people/{id} {
      allow read: if true;
      allow create, update: if signedIn() && id.size() == 16
        && request.resource.data.keys().hasOnly(['acct', 'last', 'seen', 'v', 'crew', 'days', 'style', 'len', 'goals', 'exp', 'home', 'tailored'])
        && request.resource.data.seen.size() <= 800;
    }
    match /usage/{id} {
      allow read: if true;
      allow create, update: if signedIn() && id.size() == 16
        && request.resource.data.keys().hasOnly(['last', 'seen', 'v', 'crew', 'people', 'days', 'style', 'len', 'goals', 'exp', 'home', 'tailored'])
        && request.resource.data.seen.size() <= 800;
    }

    // Feedback and feature requests. The sender and the admin can read them; only the admin can answer or delete.
    match /feedback/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 3000
        && request.resource.data.status == 'new' && !('reply' in request.resource.data);
      allow read: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if admin();
      allow delete: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /crews/{crewId} {
      // Creating a crew makes you its owner. Members can rename it or change the code,
      // but nobody can hand ownership to someone else or delete the crew from the app.
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid;
      allow read: if member(crewId);
      allow update: if member(crewId) && (request.resource.data.owner == resource.data.owner
        // the owner can hand the crew to another member (when deleting their account)
        || (crewOwner(crewId) && exists(/databases/$(database)/documents/crews/$(crewId)/members/$(request.resource.data.owner)))
        // if the owner is gone, a remaining member can take over
        || (request.resource.data.owner == request.auth.uid && !exists(/databases/$(database)/documents/crews/$(crewId)/members/$(resource.data.owner))));
      // Only the owner can delete a crew (the app does this when the last member deletes their account).
      allow delete: if crewOwner(crewId);

      match /members/{uid} {
        allow read: if member(crewId);
        // Join yourself: as the owner, or as a regular member holding a valid invite code for this crew.
        allow create: if signedIn() && request.auth.uid == uid && (
          (crewOwner(crewId) && request.resource.data.role == 'owner') ||
          (request.resource.data.role == 'member' &&
           get(/databases/$(database)/documents/codes/$(request.resource.data.code)).data.crewId == crewId));
        // You can update your own entry (name, chosen profile) but not your role. The owner can update anyone.
        allow update: if crewOwner(crewId) ||
          (signedIn() && request.auth.uid == uid && request.resource.data.role == resource.data.role);
        // Leave the crew yourself, or be removed by the owner.
        allow delete: if signedIn() && (request.auth.uid == uid || crewOwner(crewId));
      }

      // Workouts, body entries, library, profiles, settings, high-fives: any member can read and write.
      match /{coll}/{docId} {
        allow read, write: if coll != 'members' && member(crewId);
      }
    }
  }
}
